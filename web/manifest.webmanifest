{
  "id": "muse-web",
  "name": "Muse Web Screen",
  "short_name": "Muse Screen",
  "description": "The twin of the Muse ESP32-S3-BOX-3 Screen in the browser: an always-on display of the assistant's cards and scenes.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f3f3f3",
  "theme_color": "#f3f3f3",
  "lang": "de",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ]
}
